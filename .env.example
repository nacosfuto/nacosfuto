# =============================================================================
# NACOS FUTO Monorepo Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE (SYSTEM OF RECORD)
# Core database, user accounts, RLS policies, payment & academic records
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# 2. CLOUDINARY (MEDIA INFRASTRUCTURE - CLIENT-SIDE CONFIG)
# Exposed to the browser with VITE_ prefix. DO NOT put API Secret here.
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=nacos-futo
VITE_CLOUDINARY_UPLOAD_PRESET=nacos_portal_preset

# -----------------------------------------------------------------------------
# 3. CLOUDINARY (MEDIA INFRASTRUCTURE - SERVER-SIDE SECRET CONFIG)
# Used ONLY by Vercel Serverless Functions (/api/cloudinary/*) and Node dev server.
# NEVER expose CLOUDINARY_API_SECRET to client-side code or browser bundles!
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=nacos-futo
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# -----------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL SERVICE (POWERED BY RESEND)
# Official delivery service for OTP verification, password reset & receipts.
# SECRECY NOTICE: Server-side only! NEVER prefix with VITE_ or expose to browsers!
# -----------------------------------------------------------------------------
# Primary Provider: 'resend' | 'smtp' (defaults to 'resend' if configured)
EMAIL_PROVIDER=resend

# --- Resend Production Configuration ---
# Generate your API Key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Email (Source of Truth for your domain in Resend)
# Once domain is verified in Resend (e.g. nacosfuto.org.ng), use your domain email:
# Example: noreply@nacosfuto.org.ng (or onboarding@resend.dev during sandbox testing)
RESEND_FROM_EMAIL=noreply@nacosfuto.org.ng

# Sender Display Name (defaults to 'NACOS FUTO')
RESEND_FROM_NAME="NACOS FUTO"

# Reply-To Address (Where recipients' replies are directed)
# Unlike RESEND_FROM_EMAIL (which can be an unmonitored noreply@ alias),
# RESEND_REPLY_TO MUST be a real, monitored support mailbox (e.g. support@nacosfuto.org.ng).
# When students click "Reply" in their email client, their client directs replies here.
RESEND_REPLY_TO=support@nacosfuto.org.ng

# --- Optional SMTP Secondary Fallback (Nodemailer) ---
# Used only if RESEND_API_KEY is not configured or as fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="NACOS FUTO" <no-reply@nacosfuto.org.ng>

# -----------------------------------------------------------------------------
# 5. PHONE CODE VERIFICATION (POWERED BY TERMII)
# https://termii.com
# -----------------------------------------------------------------------------
# Client-side (Optional overrides):
VITE_SMS_PROVIDER=api

# Server-side (Set in root .env or Vercel Dashboard):
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=dnd


# -----------------------------------------------------------------------------
# 6. BACKBLAZE B2 OBJECT STORAGE (STUDENT RESOURCE HUB INFRASTRUCTURE)
# S3-compatible cloud object storage for lecture notes, past questions, and videos
# -----------------------------------------------------------------------------
VITE_B2_KEY_ID=your_backblaze_key_id_here
VITE_B2_APPLICATION_KEY=your_backblaze_application_key_here
VITE_B2_BUCKET_ID=your_backblaze_bucket_id_here
VITE_B2_BUCKET_NAME=nacos-resources
VITE_B2_PUBLIC_URL=https://f005.backblazeb2.com/file/nacos-resources

# Server-side / Edge Function Secrets:
B2_KEY_ID=your_backblaze_key_id_here
B2_APPLICATION_KEY=your_backblaze_application_key_here
B2_BUCKET_ID=your_backblaze_bucket_id_here
B2_BUCKET_NAME=nacos-resources
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/nacos-resources

# -----------------------------------------------------------------------------
# 7. BACHS PAYMENT GATEWAY (NACOS Student ID Card Payment)
# https://bachs.io
# -----------------------------------------------------------------------------
# Official ID Card fee determined server-side (default: 5000 NGN)
NACOS_ID_CARD_AMOUNT=5000
NACOS_ID_CARD_CURRENCY=NGN

# Private Bachs credentials (NEVER expose to client-side code)
BACHS_API_KEY=your_bachs_api_key_here
BACHS_ENVIRONMENT=sandbox
BACHS_ID_CARD_PRODUCT_ID=prod_nacos_id_card
BACHS_WEBHOOK_SECRET=whsec_your_bachs_webhook_secret_here

# -----------------------------------------------------------------------------
# 8. APPLICATION DEPLOYMENT
# -----------------------------------------------------------------------------
PORT=5173
NODE_ENV=production

