{
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?_apiPath=$1"
    },
    {
      "source": "/(webhook|webhooks|bachs-webhook)(.*)",
      "destination": "/api?_apiPath=payments/webhook"
    },
    {
      "source": "/portal-admin",
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/portal-admin/((?!.*\\.).*)",
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!.*\\.).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/gateway-redirect.html",
      "destination": "/portal/gateway-redirect.html"
    },
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/((?!.*\\.).*)",
      "destination": "/portal/index.html"
    },
    {
      "source": "/id-card",
      "destination": "/portal/index.html"
    },
    {
      "source": "/id-card/((?!.*\\.).*)",
      "destination": "/portal/index.html"
    },
    {
      "source": "/dues",
      "destination": "/portal/index.html"
    },
    {
      "source": "/dues/((?!.*\\.).*)",
      "destination": "/portal/index.html"
    },
    {
      "source": "/upskill-hub",
      "destination": "/upskill-hub/index.html"
    },
    {
      "source": "/upskill-hub/((?!.*\\.).*)",
      "destination": "/upskill-hub/index.html"
    },
    {
      "source": "/electra-admin",
      "destination": "/electra-admin/index.html"
    },
    {
      "source": "/electra-admin/((?!.*\\.).*)",
      "destination": "/electra-admin/index.html"
    },
    {
      "source": "/electra",
      "destination": "/electra/index.html"
    },
    {
      "source": "/electra/((?!.*\\.).*)",
      "destination": "/electra/index.html"
    },
    {
      "source": "/((?!api/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}